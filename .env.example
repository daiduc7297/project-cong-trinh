# MongoDB Atlas → Connect → Drivers
# Windows: nếu login/seed báo querySrv ECONNREFUSED, dùng chuỗi mongodb:// (không +srv)
# Connect → Drivers → driver cũ, hoặc copy 3 host shard + replicaSet + tls=true
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/tiendo?retryWrites=true&w=majority
MONGODB_DB=tiendo

# Auth.js / NextAuth — openssl rand -base64 32
AUTH_SECRET=thay-bang-chuoi-ngau-nhien
# Production: https://your-app.vercel.app
AUTH_URL=http://localhost:3000

# Chỉ dùng khi chạy npm run seed
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=doi-mat-khau
ADMIN_NAME=Quản trị
